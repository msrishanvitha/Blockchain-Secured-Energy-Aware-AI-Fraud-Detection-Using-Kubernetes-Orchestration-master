{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FraudLog",
  "type": "object",
  "properties": {
    "transaction_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "user_id": { "type": "string" },
    "amount": { "type": "number" },
    "model_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "energy_consumed": { "type": "number" },
    "carbon_footprint": { "type": "number" },
    "status": { "type": "string", "enum": ["fraud", "legit", "suspect"] }
  },
  "required": ["transaction_id", "timestamp", "model_confidence", "status"]
}
 